# Smart Retail DB — editable runtime settings
# Copy this file to .env and adjust values as needed.
# Environment variables override values defined in .env.

SMARTDB_DIR=./retail_data
SMARTDB_PAGE_SIZE=4096
SMARTDB_BUFFER_FRAMES=64
SMARTDB_POLICY=LRU
SMARTDB_BACKEND=page

SMARTDB_LSM_FLUSH_THRESHOLD=128
SMARTDB_LSM_COMPACTION_THRESHOLD=4

SMARTDB_SEED=42
SMARTDB_BENCH_REPEATS=5
